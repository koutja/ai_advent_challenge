# ===== Общие правила для всего репозитория =====

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# IDE / редакторы
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# Локальные настройки и секреты
.env
.env.*
*.local

# Временные файлы
*.swp
*~
*.tmp
.codeassistant/
**/demo/*.cast
**/demo/*.mp4

# demo-видео и webm/gif
**/demo/*.webm
**/demo/*.gif

# ===== Генерируемые артефакты day_NN: логи, результаты, бинарники =====
**/logs/
**/results/
**/bin/
day_*/day_*

# SQLite-базы day_* и agent (сгенерированные артефакты)
**/*.db

# Временные скриншоты тестов
screenshots/

{
  "history_file": "agent_history.db",
  "long_memory_file": "agent_longterm.db",
  "profile_file": "agent_profiles.db",
  "active_profile": "",
  "task_file": "agent_task.db",
  "invariants_file": "agent_invariants.db",
  "keep_last": 10,
  "summarize_after": 10,
  "compress": true,
  "max_tokens": 0,
  "context_window": 32768,
  "web_addr": "0.0.0.0:8080",
  "web_dir": "web",
  "context_strategy": "window",
  "window_size": 10,
  "facts_keep_last": 10,
  "facts_key_max": 50,
  "facts_extractor": "heuristic",
  "mcp_command": "bin/mcp-server",
  "mcp_servers": [
    { "name": "tasks", "command": "bin/mcp-server", "args": ["--server", "tasks"] },
    { "name": "scheduler", "command": "bin/mcp-server", "args": ["--server", "scheduler"] },
    { "name": "knowledge", "command": "bin/mcp-server", "args": ["--server", "knowledge"] }
  ],
  "rag": {
    "enabled": true,
    "sidecar_url": "http://127.0.0.1:8734",
    "index_dir": "../index_service/index",
    "strategy": "structure",
    "top_k": 10,
    "top_k_fetch": 10,
    "top_k_keep": 4,
    "min_score": 0.3,
    "filter_enabled": true,
    "rerank": "heuristic",
    "rerank_model": "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1",
    "rewrite": { "enabled": false, "max_tokens": 80 },
    "citations": false,
    "unknown_below": 0.40,
    "max_context_chars": 6000,
    "timeout_seconds": 10,
    "system_prompt": "Ответь на вопрос строго по контексту ниже.\nПравила:\n1. Только факты из контекста. Если ответа в контексте нет — напиши ровно: «В контексте этого нет».\n2. На русском, 1–3 предложения, без вступлений и повторов вопроса.\n3. После каждого факта ставь номер источника в квадратных скобках: [1], [2].\n4. В конце добавь строку «Источники:» и перечисли использованные номера."
  }
}

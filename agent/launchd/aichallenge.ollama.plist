<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: Ollama как постоянный сервис (День 30).
  Установка: cd agent && make service-install
  Экономия ресурсов: OLLAMA_KEEP_ALIVE=3m — модель выгружается из RAM
  через 3 минуты простоя и загружается заново при первом запросе (~1–2 с).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>aichallenge.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>
    <string>0.0.0.0</string>
    <key>OLLAMA_KEEP_ALIVE</key>
    <string>3m</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/aichallenge-ollama.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/aichallenge-ollama.err.log</string>
</dict>
</plist>
